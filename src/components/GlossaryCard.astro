---
import { Image } from 'astro:assets';
import styles from './GlossaryCard.module.css';

interface Props {
  term: string;
  emoji?: string;
  emojiAlt?: string;
}

const { term, emoji, emojiAlt } = Astro.props;

// Eager glob so Astro can resolve each emoji's real dimensions at build time.
const emojis = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/glossary-emoji/*.{png,webp,gif}',
  { eager: true },
);

const source = emoji ? emojis[`../assets/glossary-emoji/${emoji}`]?.default : undefined;

if (emoji && !source) {
  throw new Error(
    `Glossary emoji "${emoji}" not found in src/assets/glossary-emoji/ (term: ${term})`,
  );
}
---

<article class={styles.card}>
  <header class={styles.header}>
    {source && <Image class={styles.emoji} src={source} alt={emojiAlt ?? ''} loading="lazy" />}
    <h2 class={styles.term}>{term}</h2>
  </header>
  <div class={styles.description}>
    <slot />
  </div>
</article>
