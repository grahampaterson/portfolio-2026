---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

import type { ImageMetadata } from "astro";

interface SnippetModule {
  meta?: {
    title?: string;
    description?: string;
    thumbnail?: ImageMetadata;
    date?: Date;
  };
}

const pages = import.meta.glob<SnippetModule>("./snippets/*.astro", {
  eager: true,
});

const links = Object.entries(pages).map(([path, mod]) => {
  return {
    href: path.replace("./snippets", "/snippets").replace(".astro", ""),
    ...mod.meta,
  };
});
const linksSorted = links.sort((a, b) => {
  return new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime();
});
---

<BaseLayout>
  <div class="container">
    {
      linksSorted.map(({ href, title }) => {
        return (
          <a href={href}>
            <div class="linkStyle">{title}</div>
          </a>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  :global(body) {
    background-color: #fff;
    color: #000;
  }

  @media (prefers-color-scheme: dark) {
    :global(body) {
      background-color: #000;
      color: #fff;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
    width: 100vw;
  }
  .linkStyle {
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.025em;
    text-align: center;
    border-bottom: 2px solid currentColor;
    color: inherit;
  }
</style>
