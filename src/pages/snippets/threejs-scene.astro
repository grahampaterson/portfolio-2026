---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const meta = {
  title: "Three.js Scene",
  description: "Orbiting shape cluster with a fragment-shader overlay",
};
---

<script>
  import * as THREE from "three";
  import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
  import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
  import { ShaderPass } from "three/examples/jsm/postprocessing/ShaderPass.js";

  const container = document.getElementById("sceneContainer");

  // Full-screen post-process: scanlines + a subtle chromatic-aberration
  // vignette, applied over the rendered scene each frame.
  const overlayShader = {
    uniforms: {
      tDiffuse: { value: null },
      uTime: { value: 0 },
      uResolution: { value: new THREE.Vector2(1, 1) },
    },
    vertexShader: /* glsl */ `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: /* glsl */ `
      uniform sampler2D tDiffuse;
      uniform float uTime;
      uniform vec2 uResolution;
      varying vec2 vUv;

      #define PI 3.14

      float cosWaves(vec2 st, float steps, float rand) {
        return cos(st.x * rand + uTime + floor(st.y * steps)) * .5 +.5;
      }

      void main() {
        vec2 center = vUv - 0.5;
        float dist = length(center);
        vec2 st = gl_FragCoord.xy / uResolution.xy;
        float steps = 160.;

        // Chromatic aberration grows toward the edges.
        float aberration = dist * 0.006;
        vec2 dir = normalize(center + 1e-6);
        float r = texture2D(tDiffuse, vUv - dir * aberration).r;
        float g = texture2D(tDiffuse, vUv).g;
        float b = texture2D(tDiffuse, vUv + dir * aberration).b;
        vec3 color = vec3(r, g, b);

        // Rolling scanlines.
        float scanline = sin((vUv.y * uResolution.y - uTime * steps) * 1.2);
        color -= smoothstep(0.85, 1.0, scanline) * 0.08;

        // // Vignette.
        // float vignette = smoothstep(0.9, 0.25, dist);
        // color *= mix(0.55, 1.0, vignette);
        float bars = cos(st.y * steps * PI) * .5 + .5;
        vec3 imageTex = texture2D(tDiffuse, st).xyz;
        float im_smap = dot(imageTex, vec3(0.2126, 0.7152, 0.0722));
        float wavey = (cosWaves(st, steps, 600.) + cosWaves(st, steps, 273.) + cosWaves(st, steps, 1023.)) / 3.;
        color = vec3(step(.7,im_smap + bars *(wavey *.2 + .5)));
        // color = imageTex;

        gl_FragColor = vec4(color, 1.0);
      }
    `,
  };

  const main = () => {
    if (container == null) return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xffffff);

    const camera = new THREE.PerspectiveCamera(
      50,
      window.innerWidth / window.innerHeight,
      0.1,
      100,
    );
    camera.position.set(0, 1.6, 4);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    container.appendChild(renderer.domElement);

    const cluster = new THREE.Group();
    scene.add(cluster);

    const greyMaterial = () =>
      new THREE.MeshStandardMaterial({ color: 0xffffff });

    const core = new THREE.Mesh(
      new THREE.IcosahedronGeometry(0.7, 0),
      greyMaterial(),
    );
    cluster.add(core);

    const orbitRadius = 1.7;
    const orbiters = [
      new THREE.TorusGeometry(0.26, 0.09, 16, 32),
      new THREE.OctahedronGeometry(0.32),
      new THREE.TetrahedronGeometry(0.36),
      new THREE.ConeGeometry(0.26, 0.5, 20),
      new THREE.SphereGeometry(0.24, 24, 24),
    ].map((geometry, i, all) => {
      const mesh = new THREE.Mesh(geometry, greyMaterial());
      const angle = (i / all.length) * Math.PI * 2;
      mesh.position.set(
        Math.cos(angle) * orbitRadius,
        0,
        Math.sin(angle) * orbitRadius,
      );
      cluster.add(mesh);
      return { mesh, angle, speed: 0.35 + i * 0.08 };
    });

    scene.add(new THREE.AmbientLight(0xffffff, 0.25));

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.2);
    keyLight.position.set(2, 3, 4);
    scene.add(keyLight);

    const rimLight = new THREE.DirectionalLight(0xffffff, 1.1);
    rimLight.position.set(-3, -1.5, -2);
    scene.add(rimLight);

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const overlayPass = new ShaderPass(overlayShader);
    overlayPass.uniforms.uResolution.value.copy(
      renderer.getDrawingBufferSize(new THREE.Vector2()),
    );
    overlayPass.renderToScreen = true;
    composer.addPass(overlayPass);

    const startTime = performance.now();
    const animate = () => {
      const elapsed = (performance.now() - startTime) / 1000;

      cluster.rotation.y += 0.004;
      core.rotation.x += 0.01;
      core.rotation.y += 0.014;

      orbiters.forEach(({ mesh, angle, speed }, i) => {
        const a = angle + elapsed * speed;
        mesh.position.set(
          Math.cos(a) * orbitRadius,
          Math.sin(elapsed * 1.3 + i) * 0.35,
          Math.sin(a) * orbitRadius,
        );
        mesh.rotation.x += 0.02;
        mesh.rotation.y += 0.015;
      });

      overlayPass.uniforms.uTime.value = elapsed;
      composer.render();
      requestAnimationFrame(animate);
    };

    const onResize = () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      composer.setSize(window.innerWidth, window.innerHeight);
      overlayPass.uniforms.uResolution.value.copy(
        renderer.getDrawingBufferSize(new THREE.Vector2()),
      );
    };
    window.addEventListener("resize", onResize);

    animate();
  };

  main();
</script>

<BaseLayout backgroundColour="#fff">
  <div id="sceneContainer"></div>
</BaseLayout>

<style>
  :global(html) {
    overflow: hidden;
  }

  #sceneContainer {
    width: 100vw;
    height: 100vh;
    display: block;
  }
</style>
