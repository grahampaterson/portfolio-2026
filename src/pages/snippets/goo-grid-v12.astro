---
export const meta = {
  title: "Goo Grid",
  description:
    "Touch-friendly quincunx goo blob animator with snap-to-grid keyframes",
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>Goo Grid</title>
  </head>
  <body>
    <div class="app">
      <header>
        <div>
          <h1>Goo Grid</h1>
          <div class="sub" id="statusLine">editing corner &middot; kf 1</div>
        </div>
        <button class="icon-btn" id="resetBtn" title="Reset">&#8634;</button>
      </header>

      <div class="canvas-card">
        <div class="canvas-wrap" id="canvasWrap">
          <div class="blob-layer" id="blobLayer"></div>
          <div class="goo-layer" id="gooLayer"></div>
          <div class="tint-layer"></div>
          <svg
            class="layer grid-svg"
            id="gridSvg"
            viewBox="0 0 6 6"
            preserveAspectRatio="none"></svg>
          <div class="layer handle-layer" id="handleLayer"></div>
        </div>
      </div>

      <div class="controls">
        <div class="slider-row">
          <label>Soft</label>
          <input type="range" id="softness" min="4" max="30" value="14" />
          <span class="slider-val" id="softnessVal">14</span>
        </div>
        <div class="slider-row">
          <label>Size</label>
          <input type="range" id="radius" min="20" max="55" value="45" />
          <span class="slider-val" id="radiusVal">45</span>
        </div>
        <div class="slider-row">
          <label>Speed</label>
          <input
            type="range"
            id="speed"
            min="250"
            max="1600"
            value="1000"
            step="50"
          />
          <span class="slider-val" id="speedVal">1.00</span>
        </div>
      </div>

      <div class="playback">
        <button class="snap-btn active" id="snapBtn">Snap 1/2</button>
        <button class="play-btn" id="playBtn">&#9654;</button>
        <button class="snap-btn" id="clearSel">Deselect</button>
      </div>

      <div class="kf-section">
        <div class="kf-title">Keyframes</div>
        <div class="kf-strip" id="kfStrip"></div>
      </div>
    </div>
  </body>
</html>

<script>
  (function () {
    const GRID = 6; // full grid is 0..6 on each axis
    const HALF = 3; // controlled quadrant is 0..3 (a 3x3 corner)
    const N_POINTS = 5; // number of independently-controlled points in the corner
    const CONTRAST = 55; // fixed contrast for the goo threshold effect

    // quincunx layout: the 4 corners of the 3x3 corner area, plus a center point
    const defaultPoints = () => [
      { x: 0.5, y: 0.5 },
      { x: 2.5, y: 0.5 },
      { x: 0.5, y: 2.5 },
      { x: 2.5, y: 2.5 },
      { x: 1.5, y: 1.5 },
    ];

    let keyframes = [{ points: defaultPoints() }];
    let selected = 0;
    let snapStep = 0.5; // 0 = off
    let radius = 0.45;
    let softness = 0.14; // in grid units, converted to px against live canvas size
    let segDuration = 1000;
    let playing = false;
    let playSeg = 0,
      playStart = 0;
    let activeIndex = -1; // index of the pixel currently selected for tap-to-place
    let blobDivs: HTMLDivElement[] = []; // fixed pool of .pixel divs for the main stage
    let canvasPx = 350; // live rendered width of canvas-wrap, kept in sync via ResizeObserver

    type Point = { x: number; y: number };
    type ThumbWrap = HTMLDivElement & { _rects: HTMLDivElement[] };

    const canvasWrap = document.getElementById("canvasWrap") as HTMLDivElement;
    const gridSvg = document.getElementById("gridSvg") as unknown as SVGSVGElement;
    const blobLayer = document.getElementById("blobLayer") as HTMLDivElement;
    const gooLayer = document.getElementById("gooLayer") as HTMLDivElement;
    const handleLayer = document.getElementById("handleLayer") as HTMLDivElement;
    const kfStrip = document.getElementById("kfStrip") as HTMLDivElement;
    const playBtn = document.getElementById("playBtn") as HTMLButtonElement;
    const snapBtn = document.getElementById("snapBtn") as HTMLButtonElement;
    const clearSelBtn = document.getElementById("clearSel") as HTMLButtonElement;
    const statusLine = document.getElementById("statusLine") as HTMLDivElement;

    const NS = "http://www.w3.org/2000/svg";
    function svgEl(tag: string, attrs: Record<string, string | number>) {
      const e = document.createElementNS(NS, tag);
      for (const k in attrs) e.setAttribute(k, String(attrs[k]));
      return e;
    }

    // ---------- geometry helpers ----------

    function mirrorSet(p: Point): Point[] {
      return [
        { x: p.x, y: p.y },
        { x: GRID - p.x, y: p.y },
        { x: p.x, y: GRID - p.y },
        { x: GRID - p.x, y: GRID - p.y },
      ];
    }

    function clampPoint(p: Point): Point {
      return {
        x: Math.min(HALF, Math.max(0, p.x)),
        y: Math.min(HALF, Math.max(0, p.y)),
      };
    }

    function applySnap(p: Point): Point {
      if (!snapStep) return p;
      return {
        x: Math.round(p.x / snapStep) * snapStep,
        y: Math.round(p.y / snapStep) * snapStep,
      };
    }

    // shortest 45°/90°-only path from p0 to p1: diagonal first, then the leftover
    // straight segment (horizontal or vertical). Returns point at progress t in [0,1].
    function bentPathPoint(p0: Point, p1: Point, t: number): Point {
      const dx = p1.x - p0.x,
        dy = p1.y - p0.y;
      const diag = Math.min(Math.abs(dx), Math.abs(dy));
      const cornerX = p0.x + Math.sign(dx) * diag;
      const cornerY = p0.y + Math.sign(dy) * diag;
      const diagLen = diag * Math.SQRT2;
      const remLen = Math.hypot(p1.x - cornerX, p1.y - cornerY);
      const total = diagLen + remLen;
      if (total === 0) return { x: p0.x, y: p0.y };
      const dist = t * total;
      if (dist <= diagLen) {
        const f = diagLen === 0 ? 1 : dist / diagLen;
        return {
          x: p0.x + (cornerX - p0.x) * f,
          y: p0.y + (cornerY - p0.y) * f,
        };
      } else {
        const f = remLen === 0 ? 1 : (dist - diagLen) / remLen;
        return {
          x: cornerX + (p1.x - cornerX) * f,
          y: cornerY + (p1.y - cornerY) * f,
        };
      }
    }

    function easeInOutQuad(t: number): number {
      return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    // ---------- pixel div helpers (percentage-positioned, so no px/viewBox math needed) ----------

    function pct(v: number): string {
      return ((v / GRID) * 100).toFixed(4) + "%";
    }

    function makePixelDiv(): HTMLDivElement {
      const d = document.createElement("div");
      d.className = "pixel";
      return d;
    }

    function setPixel(div: HTMLElement, cx: number, cy: number, r: number) {
      div.style.left = pct(cx - r);
      div.style.top = pct(cy - r);
      div.style.width = pct(r * 2);
      div.style.height = pct(r * 2);
    }

    // applies the goo effect via backdrop-filter, so it reads the raw blobs
    // sitting *behind* this layer rather than clipping its own blur to this
    // layer's box — that's what keeps blobs from looking cut off at the edge
    function applyGooFilter(layerEl: HTMLElement) {
      const blurPx = (softness / GRID) * canvasPx;
      const value = `blur(${blurPx.toFixed(2)}px) contrast(${CONTRAST})`;
      layerEl.style.backdropFilter = value;
      (layerEl.style as any).webkitBackdropFilter = value;
    }

    // ---------- main stage rendering ----------

    function buildStageOnce() {
      // grid lines (plain SVG, unfiltered — no reason for this to ever break)
      // styled via CSS custom properties so they adapt to light/dark automatically
      gridSvg.innerHTML = "";
      const bg = svgEl("rect", {
        x: 0,
        y: 0,
        width: HALF,
        height: HALF,
        style: "fill:var(--accent);fill-opacity:0.05",
      });
      gridSvg.appendChild(bg);
      for (let i = 0; i <= GRID; i++) {
        const soft = i !== 0 && i !== GRID / 2 && i !== GRID;
        const styleStr = `stroke:var(--line-strong); stroke-opacity:${soft ? 0.35 : 0.6}`;
        gridSvg.appendChild(
          svgEl("line", {
            x1: i,
            y1: 0,
            x2: i,
            y2: GRID,
            style: styleStr,
            "stroke-width": i === GRID / 2 ? 0.018 : 0.012,
          }),
        );
        gridSvg.appendChild(
          svgEl("line", {
            x1: 0,
            y1: i,
            x2: GRID,
            y2: i,
            style: styleStr,
            "stroke-width": i === GRID / 2 ? 0.018 : 0.012,
          }),
        );
      }

      // fixed pool of pixel divs — never removed/recreated, only repositioned
      blobLayer.innerHTML = "";
      blobDivs = [];
      for (let i = 0; i < N_POINTS * 4; i++) {
        const d = makePixelDiv();
        blobLayer.appendChild(d);
        blobDivs.push(d);
      }
      applyGooFilter(gooLayer);

      // handles
      handleLayer.innerHTML = "";
      for (let i = 0; i < N_POINTS; i++) {
        const h = document.createElement("div");
        h.className = "handle";
        h.dataset.i = String(i);
        const dot = document.createElement("div");
        dot.className = "handle-dot";
        h.appendChild(dot);
        h.addEventListener("click", (e) => onHandleTap(e, i));
        handleLayer.appendChild(h);
      }

      // resize observer keeps blur px in sync with actual rendered canvas size
      const ro = new ResizeObserver((entries) => {
        const w = entries[0].contentRect.width;
        if (w > 0) {
          canvasPx = w;
          applyGooFilter(gooLayer);
        }
      });
      ro.observe(canvasWrap);

      canvasWrap.addEventListener("click", onCanvasTap);
    }

    function renderBlob(points: Point[]) {
      let idx = 0;
      points.forEach((p) => {
        mirrorSet(p).forEach((m) => {
          setPixel(blobDivs[idx], m.x, m.y, radius);
          idx++;
        });
      });
    }

    function renderHandles(points: Point[]) {
      handleLayer.style.display = playing ? "none" : "";
      [...handleLayer.children].forEach((h, i) => {
        const el = h as HTMLElement;
        const p = points[i];
        el.style.left = pct(p.x);
        el.style.top = pct(p.y);
        el.classList.toggle("selected", i === activeIndex);
      });
    }

    function renderSelectedStatic() {
      const pts = keyframes[selected].points;
      renderBlob(pts);
      renderHandles(pts);
      statusLine.textContent =
        activeIndex === -1
          ? `tap a pixel to select · kf ${selected + 1} of ${keyframes.length}`
          : `pixel ${activeIndex + 1} selected · tap grid to place`;
    }

    // ---------- tap to select / tap to place ----------

    function onHandleTap(e: Event, i: number) {
      if (playing) return;
      e.stopPropagation();
      activeIndex = activeIndex === i ? -1 : i;
      renderSelectedStatic();
    }

    function onCanvasTap(e: MouseEvent) {
      if (playing || activeIndex === -1) return;
      const rect = canvasWrap.getBoundingClientRect();
      const relX = (e.clientX - rect.left) / rect.width;
      const relY = (e.clientY - rect.top) / rect.height;
      let p = clampPoint({ x: relX * GRID, y: relY * GRID });
      p = applySnap(p);
      p = clampPoint(p);
      keyframes[selected].points[activeIndex] = p;
      renderSelectedStatic();
      updateThumb(selected);
    }

    // ---------- keyframe strip ----------

    function buildThumbDOM(): ThumbWrap {
      const wrap = document.createElement("div") as ThumbWrap;
      wrap.className = "blob-layer layer";
      wrap.style.position = "absolute";
      wrap.style.inset = "0";
      const rects: HTMLDivElement[] = [];
      for (let i = 0; i < N_POINTS * 4; i++) {
        const d = makePixelDiv();
        wrap.appendChild(d);
        rects.push(d);
      }
      const blurPx = (softness / GRID) * 62; // thumbnails are a fixed 62px tile
      wrap.style.filter = `blur(${blurPx.toFixed(2)}px) contrast(${CONTRAST})`;
      wrap._rects = rects;
      return wrap;
    }

    function rebuildStrip() {
      kfStrip.innerHTML = "";
      keyframes.forEach((kf, idx) => {
        const tile = document.createElement("div");
        tile.className = "kf-tile";

        const thumb = document.createElement("div");
        thumb.className = "kf-thumb" + (idx === selected ? " selected" : "");
        const dom = buildThumbDOM();
        thumb.appendChild(dom);
        thumb.addEventListener("click", () => selectKeyframe(idx));

        const label = document.createElement("div");
        label.className = "kf-label";
        label.textContent = String(idx + 1).padStart(2, "0");

        tile.appendChild(thumb);
        tile.appendChild(label);

        if (keyframes.length > 1) {
          const del = document.createElement("button");
          del.className = "kf-del";
          del.textContent = "×";
          del.addEventListener("click", (ev) => {
            ev.stopPropagation();
            deleteKeyframe(idx);
          });
          tile.appendChild(del);
        }

        kfStrip.appendChild(tile);
      });

      const addBtn = document.createElement("button");
      addBtn.className = "kf-add";
      addBtn.textContent = "+";
      addBtn.addEventListener("click", addKeyframe);
      kfStrip.appendChild(addBtn);

      keyframes.forEach((_, idx) => updateThumb(idx));
    }

    function updateThumb(idx: number) {
      const tile = kfStrip.children[idx];
      if (!tile) return;
      const wrap = tile.querySelector(".blob-layer") as ThumbWrap | null;
      if (!wrap || !wrap._rects) return;
      let ri = 0;
      keyframes[idx].points.forEach((p) => {
        mirrorSet(p).forEach((m) => {
          setPixel(wrap._rects[ri], m.x, m.y, radius);
          ri++;
        });
      });
    }

    function selectKeyframe(idx: number) {
      if (playing) togglePlay();
      selected = idx;
      activeIndex = -1;
      renderSelectedStatic();
      [...kfStrip.querySelectorAll(".kf-thumb")].forEach((t, i) =>
        t.classList.toggle("selected", i === idx),
      );
    }

    function addKeyframe() {
      const clone = {
        points: keyframes[selected].points.map((p) => ({ x: p.x, y: p.y })),
      };
      keyframes.push(clone);
      selected = keyframes.length - 1;
      activeIndex = -1;
      rebuildStrip();
      renderSelectedStatic();
    }

    function deleteKeyframe(idx: number) {
      if (keyframes.length <= 1) return;
      keyframes.splice(idx, 1);
      if (selected >= keyframes.length) selected = keyframes.length - 1;
      activeIndex = -1;
      rebuildStrip();
      renderSelectedStatic();
    }

    // ---------- playback ----------

    function togglePlay() {
      if (keyframes.length < 2) {
        playBtn.style.background = "var(--danger)";
        setTimeout(() => {
          playBtn.style.background = "var(--accent)";
        }, 220);
        return;
      }
      playing = !playing;
      playBtn.innerHTML = playing ? "&#10073;&#10073;" : "&#9654;";
      if (playing) {
        playSeg = selected;
        playStart = performance.now();
        activeIndex = -1;
        handleLayer.style.display = "none";
        requestAnimationFrame(playTick);
      } else {
        renderSelectedStatic();
      }
    }

    function playTick(now: number) {
      if (!playing) return;
      const elapsed = now - playStart;
      const t = Math.min(elapsed / segDuration, 1);
      const eased = easeInOutQuad(t);
      const from = keyframes[playSeg].points;
      const to = keyframes[(playSeg + 1) % keyframes.length].points;
      const interp = from.map((p, i) => bentPathPoint(p, to[i], eased));
      renderBlob(interp);
      statusLine.textContent = `playing · kf ${playSeg + 1} → ${((playSeg + 1) % keyframes.length) + 1}`;
      if (t >= 1) {
        playSeg = (playSeg + 1) % keyframes.length;
        playStart = now;
      }
      requestAnimationFrame(playTick);
    }

    // ---------- controls wiring ----------

    const softnessSlider = document.getElementById(
      "softness",
    ) as HTMLInputElement;
    const softnessVal = document.getElementById("softnessVal") as HTMLElement;
    const radiusSlider = document.getElementById("radius") as HTMLInputElement;
    const radiusVal = document.getElementById("radiusVal") as HTMLElement;
    const speedSlider = document.getElementById("speed") as HTMLInputElement;
    const speedVal = document.getElementById("speedVal") as HTMLElement;

    softnessSlider.addEventListener("input", (e) => {
      const v = parseInt((e.target as HTMLInputElement).value, 10);
      softnessVal.textContent = String(v);
      softness = v / 100;
      applyGooFilter(gooLayer);
      keyframes.forEach((_, idx) => {
        const tile = kfStrip.children[idx];
        const wrap = tile && (tile.querySelector(".blob-layer") as HTMLElement | null);
        if (wrap) {
          const blurPx = (softness / GRID) * 62;
          wrap.style.filter = `blur(${blurPx.toFixed(2)}px) contrast(${CONTRAST})`;
        }
      });
    });
    radiusSlider.addEventListener("input", (e) => {
      const v = parseInt((e.target as HTMLInputElement).value, 10);
      radiusVal.textContent = String(v);
      radius = v / 100;
      renderSelectedStatic();
      keyframes.forEach((_, idx) => updateThumb(idx));
    });
    speedSlider.addEventListener("input", (e) => {
      segDuration = parseInt((e.target as HTMLInputElement).value, 10);
      speedVal.textContent = (segDuration / 1000).toFixed(2);
    });

    snapBtn.addEventListener("click", () => {
      if (snapStep === 0.5) {
        snapStep = 0.25;
        snapBtn.textContent = "Snap 1/4";
      } else if (snapStep === 0.25) {
        snapStep = 0;
        snapBtn.textContent = "Snap Off";
        snapBtn.classList.remove("active");
        return;
      } else {
        snapStep = 0.5;
        snapBtn.textContent = "Snap 1/2";
      }
      snapBtn.classList.add("active");
    });

    clearSelBtn.addEventListener("click", () => {
      if (playing) togglePlay();
      activeIndex = -1;
      renderSelectedStatic();
    });

    playBtn.addEventListener("click", togglePlay);

    (document.getElementById("resetBtn") as HTMLButtonElement).addEventListener("click", () => {
      playing = false;
      playBtn.innerHTML = "&#9654;";
      keyframes = [{ points: defaultPoints() }];
      selected = 0;
      activeIndex = -1;
      rebuildStrip();
      renderSelectedStatic();
    });

    // ---------- init ----------
    canvasPx = canvasWrap.getBoundingClientRect().width || 350;
    buildStageOnce();
    rebuildStrip();
    renderSelectedStatic();
  })();
</script>

<style is:global>
  :root {
    --bg: #d6d6d3;
    --panel: #e6e6e2;
    --line: #b7b6b1;
    --line-strong: #1a1a1a;
    --ink: #171717;
    --ink-dim: #6f6e6a;
    --accent: #e8560f;
    --blob: #181818;
    --danger: #b3382a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #202020;
      --panel: #292927;
      --line: #48473f;
      --line-strong: #4e4d47;
      --ink: #eeecea;
      --ink-dim: #8d8c89;
      --accent: #ff7a33;
      --blob: #eeeeee;
      --danger: #d9604c;
    }
  }
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family:
      ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }
  .app {
    height: 100dvh;
    width: 100vw;
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    padding: max(14px, env(safe-area-inset-top)) 16px
      max(14px, env(safe-area-inset-bottom));
    gap: 14px;
  }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-shrink: 0;
  }
  header h1 {
    font-size: 14px;
    letter-spacing: 0.18em;
    margin: 0;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
  }
  header h1::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--accent);
    margin-right: 8px;
    border-radius: 1px;
  }
  header .sub {
    font-size: 10px;
    color: var(--ink-dim);
    letter-spacing: 0.03em;
    margin-top: 4px;
    margin-left: 15px;
  }
  .icon-btn {
    background: var(--panel);
    border: 1.5px solid var(--line-strong);
    color: var(--ink);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    touch-action: manipulation;
  }
  .icon-btn:active {
    background: var(--line);
  }

  .canvas-card {
    flex-shrink: 0;
  }
  .canvas-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    touch-action: none;
    background: var(--bg);
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 1. blobs — raw, unblurred shapes; the goo-layer above reads these
     as its backdrop, so they stay crisp here */
  .blob-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .pixel {
    position: absolute;
    background: var(--blob);
    border-radius: 16%;
  }

  /* 2 & 3 share one oversized "bleed" box, wider than the raw blobs can ever
     spill past the canvas (radius + blur). Nothing here is clipped — the
     canvas has no overflow:hidden — so the goo blur and the background tint
     both extend past the visible edge right along with the blobs themselves,
     instead of stopping dead at the canvas boundary. */
  .goo-layer,
  .tint-layer {
    position: absolute;
    left: -20%;
    top: -20%;
    width: 140%;
    height: 140%;
    pointer-events: none;
  }

  /* 2. goo — backdrop-filter blur+contrast melts the raw blobs together */
  .goo-layer {
    z-index: 1;
  }

  /* 3. tint — washes the page background colour over the goo result via
     multiply, so the white gaps between blobs read as the theme's bg
     instead of stark white */
  .tint-layer {
    z-index: 2;
    background: var(--bg);
    mix-blend-mode: multiply;
  }

  /* 4. UI — grid reference lines and drag handles, unaffected by the above */
  .grid-svg {
    z-index: 3;
    display: block;
    pointer-events: none;
  }

  .handle-layer {
    z-index: 4;
  }
  .handle {
    position: absolute;
    width: 12%;
    height: 12%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .handle-dot {
    width: 24%;
    height: 24%;
    border-radius: 2px;
    background: var(--accent);
    border: 2px solid var(--bg);
    pointer-events: none;
  }
  .handle.selected .handle-dot {
    width: 40%;
    height: 40%;
    background: #fff;
    border-color: var(--accent);
  }

