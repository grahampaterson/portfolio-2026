---
export const meta = {
  title: "Goo Grid",
  description:
    "Touch-friendly quincunx goo blob animator with snap-to-grid keyframes",
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <title>Goo Grid</title>
  </head>
  <body>
    <!--
      Rendering structure below mirrors a known-working reference exactly:
      base background -> raw pixels -> blur overlay -> contrast overlay ->
      tint overlay -> UI, with the three effect overlays spanning the whole
      field (not just the square grid) so nothing ever gets cropped/fringed
      at an overlay's own edge. Do not add wrapper divs, blend modes, or
      oversized "bleed" boxes here — those are exactly what broke Safari
      before. All the interactive keyframe/editing controls live in the
      floating panel further down, kept deliberately separate so they can
      never affect this stack.
    -->
    <div class="field" id="field">
      <div class="stage" id="pixelStage"></div>

      <div class="overlay blur" id="blurLayer"></div>
      <div class="overlay contrast" id="contrastLayer"></div>
      <div class="overlay tint"></div>

      <div class="stage" id="uiStage">
        <svg
          class="grid-svg"
          id="gridSvg"
          viewBox="0 0 6 6"
          preserveAspectRatio="none"></svg>
        <div class="handle-layer" id="handleLayer"></div>
      </div>
    </div>

    <div class="debug-panel" id="debugPanel">
      <div class="playback">
        <button class="play-btn" id="playBtn">&#9654;</button>
        <button class="icon-btn" id="collapseBtn" title="Collapse">&#9662;</button>
      </div>

      <div class="panel-body" id="panelBody">
        <div class="controls">
          <div class="slider-row">
            <label>Soft</label>
            <input type="range" id="softness" min="4" max="30" value="14" />
            <span class="slider-val" id="softnessVal">14</span>
          </div>
          <div class="slider-row">
            <label>Size</label>
            <input type="range" id="radius" min="20" max="55" value="45" />
            <span class="slider-val" id="radiusVal">45</span>
          </div>
          <div class="slider-row">
            <label>Speed</label>
            <input
              type="range"
              id="speed"
              min="250"
              max="1600"
              value="1000"
              step="50"
            />
            <span class="slider-val" id="speedVal">1.00</span>
          </div>
        </div>

        <div class="playback">
          <button class="snap-btn active" id="snapBtn">Snap 1/2</button>
          <button class="icon-btn" id="resetBtn" title="Reset">&#8634;</button>
        </div>

        <div class="kf-section">
          <div class="kf-title">Keyframes</div>
          <div class="kf-strip" id="kfStrip"></div>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  (function () {
    const GRID = 6; // full grid is 0..6 on each axis
    const N_POINTS = 5; // number of independently-controlled points
    const CONTRAST = 55; // fixed contrast for the goo threshold effect

    // quincunx layout: a starting point in each quadrant, plus a center point.
    // points are free to move to any quadrant — mirrorSet() always produces
    // the same 4-way symmetric group regardless of which quadrant a point
    // currently sits in
    const defaultPoints = () => [
      { x: 0.5, y: 0.5 },
      { x: 2.5, y: 0.5 },
      { x: 0.5, y: 2.5 },
      { x: 2.5, y: 2.5 },
      { x: 1.5, y: 1.5 },
    ];

    type Point = { x: number; y: number };
    type ThumbWrap = HTMLDivElement & { _rects: HTMLDivElement[] };
    type SavedState = {
      keyframes: { points: Point[] }[];
      selected: number;
      snapStep: number;
      radius: number;
      softness: number;
      segDuration: number;
      collapsed: boolean;
    };

    const STORAGE_KEY = "goo-grid-v12";

    // reads persisted state back out of localStorage, so a reload picks up
    // wherever you left off; returns null on anything missing/corrupt/blocked
    // (private browsing, quota, stale shape from an older version) so the
    // caller can fall back to defaults
    function loadState(): SavedState | null {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const data = JSON.parse(raw);
        const validPoint = (p: any) =>
          p && typeof p.x === "number" && typeof p.y === "number";
        const validKeyframes =
          Array.isArray(data.keyframes) &&
          data.keyframes.length > 0 &&
          data.keyframes.every(
            (kf: any) =>
              Array.isArray(kf.points) &&
              kf.points.length === N_POINTS &&
              kf.points.every(validPoint),
          );
        if (!validKeyframes) return null;
        return data as SavedState;
      } catch {
        return null;
      }
    }

    function saveState() {
      try {
        const data: SavedState = {
          keyframes,
          selected,
          snapStep,
          radius,
          softness,
          segDuration,
          collapsed,
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch {
        // private browsing / quota exceeded — persistence is a nice-to-have, not required
      }
    }

    const saved = loadState();

    let keyframes = saved?.keyframes ?? [{ points: defaultPoints() }];
    let selected =
      saved && saved.selected >= 0 && saved.selected < keyframes.length
        ? saved.selected
        : 0;
    let snapStep = saved?.snapStep ?? 0.5; // 0 = off
    let radius = saved?.radius ?? 0.45;
    let softness = saved?.softness ?? 0.14; // in grid units, converted to px against live stage size
    let segDuration = saved?.segDuration ?? 1000;
    let collapsed = saved?.collapsed ?? false;
    let playing = false;
    let playSeg = 0,
      playStart = 0;
    let activeIndex = -1; // index of the pixel currently selected for tap-to-place
    let pixelDivs: HTMLDivElement[] = []; // fixed pool of .pixel divs for the main stage
    let stagePx = 350; // live rendered width of the stage square, kept in sync via ResizeObserver

    const pixelStage = document.getElementById("pixelStage") as HTMLDivElement;
    const uiStage = document.getElementById("uiStage") as HTMLDivElement;
    const gridSvg = document.getElementById(
      "gridSvg",
    ) as unknown as SVGSVGElement;
    const blurLayer = document.getElementById("blurLayer") as HTMLDivElement;
    const contrastLayer = document.getElementById(
      "contrastLayer",
    ) as HTMLDivElement;
    const handleLayer = document.getElementById(
      "handleLayer",
    ) as HTMLDivElement;
    const kfStrip = document.getElementById("kfStrip") as HTMLDivElement;
    const playBtn = document.getElementById("playBtn") as HTMLButtonElement;
    const snapBtn = document.getElementById("snapBtn") as HTMLButtonElement;
    const debugPanel = document.getElementById("debugPanel") as HTMLDivElement;
    const collapseBtn = document.getElementById(
      "collapseBtn",
    ) as HTMLButtonElement;

    const NS = "http://www.w3.org/2000/svg";
    function svgEl(tag: string, attrs: Record<string, string | number>) {
      const e = document.createElementNS(NS, tag);
      for (const k in attrs) e.setAttribute(k, String(attrs[k]));
      return e;
    }

    // ---------- geometry helpers ----------

    function mirrorSet(p: Point): Point[] {
      return [
        { x: p.x, y: p.y },
        { x: GRID - p.x, y: p.y },
        { x: p.x, y: GRID - p.y },
        { x: GRID - p.x, y: GRID - p.y },
      ];
    }

    function clampPoint(p: Point): Point {
      return {
        x: Math.min(GRID, Math.max(0, p.x)),
        y: Math.min(GRID, Math.max(0, p.y)),
      };
    }

    function applySnap(p: Point): Point {
      if (!snapStep) return p;
      return {
        x: Math.round(p.x / snapStep) * snapStep,
        y: Math.round(p.y / snapStep) * snapStep,
      };
    }

    // shortest 45°/90°-only path from p0 to p1: diagonal first, then the leftover
    // straight segment (horizontal or vertical). Returns point at progress t in [0,1].
    function bentPathPoint(p0: Point, p1: Point, t: number): Point {
      const dx = p1.x - p0.x,
        dy = p1.y - p0.y;
      const diag = Math.min(Math.abs(dx), Math.abs(dy));
      const cornerX = p0.x + Math.sign(dx) * diag;
      const cornerY = p0.y + Math.sign(dy) * diag;
      const diagLen = diag * Math.SQRT2;
      const remLen = Math.hypot(p1.x - cornerX, p1.y - cornerY);
      const total = diagLen + remLen;
      if (total === 0) return { x: p0.x, y: p0.y };
      const dist = t * total;
      if (dist <= diagLen) {
        const f = diagLen === 0 ? 1 : dist / diagLen;
        return {
          x: p0.x + (cornerX - p0.x) * f,
          y: p0.y + (cornerY - p0.y) * f,
        };
      } else {
        const f = remLen === 0 ? 1 : (dist - diagLen) / remLen;
        return {
          x: cornerX + (p1.x - cornerX) * f,
          y: cornerY + (p1.y - cornerY) * f,
        };
      }
    }

    function easeInOutQuad(t: number): number {
      return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    // ---------- pixel div helpers (percentage-positioned, so no px/viewBox math needed) ----------

    function pct(v: number): string {
      return ((v / GRID) * 100).toFixed(4) + "%";
    }

    function makePixelDiv(): HTMLDivElement {
      const d = document.createElement("div");
      d.className = "pixel";
      return d;
    }

    function setPixel(div: HTMLElement, cx: number, cy: number, r: number) {
      div.style.left = pct(cx - r);
      div.style.top = pct(cy - r);
      div.style.width = pct(r * 2);
      div.style.height = pct(r * 2);
    }

    // -webkit- prefixed first: iOS/older Safari only recognizes that IDL
    // name on element.style, so setting it second would be a silent no-op there
    function setBackdropFilter(layerEl: HTMLElement, value: string) {
      (layerEl.style as any).webkitBackdropFilter = value;
      layerEl.style.backdropFilter = value;
    }

    // blur and contrast are two separate backdrop-filter layers rather than
    // one combined `backdrop-filter: blur() contrast()` — Safari doesn't
    // reliably chain multiple filter functions within a single backdrop-filter
    function applyBlur(layerEl: HTMLElement) {
      const blurPx = (softness / GRID) * stagePx;
      setBackdropFilter(layerEl, `blur(${blurPx.toFixed(2)}px)`);
    }

    // ---------- main stage rendering ----------

    function buildStageOnce() {
      // grid lines (plain SVG, unfiltered — no reason for this to ever break)
      // styled via CSS custom properties so they adapt to light/dark automatically
      gridSvg.innerHTML = "";
      for (let i = 0; i <= GRID; i++) {
        const soft = i !== 0 && i !== GRID / 2 && i !== GRID;
        const styleStr = `stroke:var(--line-strong); stroke-opacity:${soft ? 0.35 : 0.6}`;
        gridSvg.appendChild(
          svgEl("line", {
            x1: i,
            y1: 0,
            x2: i,
            y2: GRID,
            style: styleStr,
            "stroke-width": i === GRID / 2 ? 0.018 : 0.012,
          }),
        );
        gridSvg.appendChild(
          svgEl("line", {
            x1: 0,
            y1: i,
            x2: GRID,
            y2: i,
            style: styleStr,
            "stroke-width": i === GRID / 2 ? 0.018 : 0.012,
          }),
        );
      }

      // fixed pool of pixel divs — never removed/recreated, only repositioned
      pixelStage.innerHTML = "";
      pixelDivs = [];
      for (let i = 0; i < N_POINTS * 4; i++) {
        const d = makePixelDiv();
        pixelStage.appendChild(d);
        pixelDivs.push(d);
      }
      setBackdropFilter(contrastLayer, `contrast(${CONTRAST})`); // fixed, set once
      applyBlur(blurLayer);

      // handles
      handleLayer.innerHTML = "";
      for (let i = 0; i < N_POINTS; i++) {
        const h = document.createElement("div");
        h.className = "handle";
        h.dataset.i = String(i);
        const dot = document.createElement("div");
        dot.className = "handle-dot";
        h.appendChild(dot);
        h.addEventListener("click", (e) => onHandleTap(e, i));
        handleLayer.appendChild(h);
      }

      // resize observer keeps blur px in sync with actual rendered stage size
      const ro = new ResizeObserver((entries) => {
        const w = entries[0].contentRect.width;
        if (w > 0) {
          stagePx = w;
          applyBlur(blurLayer);
        }
      });
      ro.observe(uiStage);

      uiStage.addEventListener("click", onStageTap);
    }

    function renderBlob(points: Point[]) {
      let idx = 0;
      points.forEach((p) => {
        mirrorSet(p).forEach((m) => {
          setPixel(pixelDivs[idx], m.x, m.y, radius);
          idx++;
        });
      });
    }

    function renderHandles(points: Point[]) {
      handleLayer.style.display = playing ? "none" : "";
      [...handleLayer.children].forEach((h, i) => {
        const el = h as HTMLElement;
        const p = points[i];
        el.style.left = pct(p.x);
        el.style.top = pct(p.y);
        el.classList.toggle("selected", i === activeIndex);
      });
    }

    function renderSelectedStatic() {
      const pts = keyframes[selected].points;
      renderBlob(pts);
      renderHandles(pts);
    }

    // ---------- tap to select / tap to place ----------

    function onHandleTap(e: Event, i: number) {
      if (playing) return;
      e.stopPropagation();
      activeIndex = activeIndex === i ? -1 : i;
      renderSelectedStatic();
    }

    function onStageTap(e: MouseEvent) {
      if (playing || activeIndex === -1) return;
      const rect = uiStage.getBoundingClientRect();
      const relX = (e.clientX - rect.left) / rect.width;
      const relY = (e.clientY - rect.top) / rect.height;
      let p = clampPoint({ x: relX * GRID, y: relY * GRID });
      p = applySnap(p);
      p = clampPoint(p);
      keyframes[selected].points[activeIndex] = p;
      renderSelectedStatic();
      updateThumb(selected);
      saveState();
    }

    // ---------- keyframe strip ----------

    function buildThumbDOM(): ThumbWrap {
      const wrap = document.createElement("div") as ThumbWrap;
      wrap.className = "thumb-blobs";
      const rects: HTMLDivElement[] = [];
      for (let i = 0; i < N_POINTS * 4; i++) {
        const d = makePixelDiv();
        wrap.appendChild(d);
        rects.push(d);
      }
      const blurPx = (softness / GRID) * 62; // thumbnails are a fixed 62px tile
      wrap.style.filter = `blur(${blurPx.toFixed(2)}px) contrast(${CONTRAST})`;
      wrap._rects = rects;
      return wrap;
    }

    function rebuildStrip() {
      kfStrip.innerHTML = "";
      keyframes.forEach((_, idx) => {
        const tile = document.createElement("div");
        tile.className = "kf-tile";

        const thumb = document.createElement("div");
        thumb.className = "kf-thumb" + (idx === selected ? " selected" : "");
        const dom = buildThumbDOM();
        thumb.appendChild(dom);
        thumb.addEventListener("click", () => selectKeyframe(idx));

        const label = document.createElement("div");
        label.className = "kf-label";
        label.textContent = String(idx + 1).padStart(2, "0");

        tile.appendChild(thumb);
        tile.appendChild(label);

        if (keyframes.length > 1) {
          const del = document.createElement("button");
          del.className = "kf-del";
          del.textContent = "×";
          del.addEventListener("click", (ev) => {
            ev.stopPropagation();
            deleteKeyframe(idx);
          });
          tile.appendChild(del);
        }

        kfStrip.appendChild(tile);
      });

      const addBtn = document.createElement("button");
      addBtn.className = "kf-add";
      addBtn.textContent = "+";
      addBtn.addEventListener("click", addKeyframe);
      kfStrip.appendChild(addBtn);

      keyframes.forEach((_, idx) => updateThumb(idx));
    }

    function updateThumb(idx: number) {
      const tile = kfStrip.children[idx];
      if (!tile) return;
      const wrap = tile.querySelector(".thumb-blobs") as ThumbWrap | null;
      if (!wrap || !wrap._rects) return;
      let ri = 0;
      keyframes[idx].points.forEach((p) => {
        mirrorSet(p).forEach((m) => {
          setPixel(wrap._rects[ri], m.x, m.y, radius);
          ri++;
        });
      });
    }

    function selectKeyframe(idx: number) {
      if (playing) togglePlay();
      selected = idx;
      activeIndex = -1;
      renderSelectedStatic();
      [...kfStrip.querySelectorAll(".kf-thumb")].forEach((t, i) =>
        t.classList.toggle("selected", i === idx),
      );
      saveState();
    }

    function addKeyframe() {
      const clone = {
        points: keyframes[selected].points.map((p) => ({ x: p.x, y: p.y })),
      };
      keyframes.push(clone);
      selected = keyframes.length - 1;
      activeIndex = -1;
      rebuildStrip();
      renderSelectedStatic();
      saveState();
    }

    function deleteKeyframe(idx: number) {
      if (keyframes.length <= 1) return;
      keyframes.splice(idx, 1);
      if (selected >= keyframes.length) selected = keyframes.length - 1;
      activeIndex = -1;
      rebuildStrip();
      renderSelectedStatic();
      saveState();
    }

    // ---------- playback ----------

    function togglePlay() {
      if (keyframes.length < 2) {
        playBtn.style.background = "var(--danger)";
        setTimeout(() => {
          playBtn.style.background = "var(--accent)";
        }, 220);
        return;
      }
      playing = !playing;
      playBtn.innerHTML = playing ? "&#10073;&#10073;" : "&#9654;";
      if (playing) {
        playSeg = selected;
        playStart = performance.now();
        activeIndex = -1;
        handleLayer.style.display = "none";
        requestAnimationFrame(playTick);
      } else {
        renderSelectedStatic();
      }
    }

    function playTick(now: number) {
      if (!playing) return;
      const elapsed = now - playStart;
      const t = Math.min(elapsed / segDuration, 1);
      const eased = easeInOutQuad(t);
      const from = keyframes[playSeg].points;
      const to = keyframes[(playSeg + 1) % keyframes.length].points;
      const interp = from.map((p, i) => bentPathPoint(p, to[i], eased));
      renderBlob(interp);
      if (t >= 1) {
        playSeg = (playSeg + 1) % keyframes.length;
        playStart = now;
      }
      requestAnimationFrame(playTick);
    }

    // ---------- controls wiring ----------

    const softnessSlider = document.getElementById(
      "softness",
    ) as HTMLInputElement;
    const softnessVal = document.getElementById("softnessVal") as HTMLElement;
    const radiusSlider = document.getElementById("radius") as HTMLInputElement;
    const radiusVal = document.getElementById("radiusVal") as HTMLElement;
    const speedSlider = document.getElementById("speed") as HTMLInputElement;
    const speedVal = document.getElementById("speedVal") as HTMLElement;

    softnessSlider.addEventListener("input", (e) => {
      const v = parseInt((e.target as HTMLInputElement).value, 10);
      softnessVal.textContent = String(v);
      softness = v / 100;
      applyBlur(blurLayer);
      keyframes.forEach((_, idx) => {
        const tile = kfStrip.children[idx];
        const wrap =
          tile && (tile.querySelector(".thumb-blobs") as HTMLElement | null);
        if (wrap) {
          const blurPx = (softness / GRID) * 62;
          wrap.style.filter = `blur(${blurPx.toFixed(2)}px) contrast(${CONTRAST})`;
        }
      });
      saveState();
    });
    radiusSlider.addEventListener("input", (e) => {
      const v = parseInt((e.target as HTMLInputElement).value, 10);
      radiusVal.textContent = String(v);
      radius = v / 100;
      renderSelectedStatic();
      keyframes.forEach((_, idx) => updateThumb(idx));
      saveState();
    });
    speedSlider.addEventListener("input", (e) => {
      segDuration = parseInt((e.target as HTMLInputElement).value, 10);
      speedVal.textContent = (segDuration / 1000).toFixed(2);
      saveState();
    });

    snapBtn.addEventListener("click", () => {
      if (snapStep === 0.5) {
        snapStep = 0.25;
        snapBtn.textContent = "Snap 1/4";
      } else if (snapStep === 0.25) {
        snapStep = 0;
        snapBtn.textContent = "Snap Off";
        snapBtn.classList.remove("active");
        saveState();
        return;
      } else {
        snapStep = 0.5;
        snapBtn.textContent = "Snap 1/2";
      }
      snapBtn.classList.add("active");
      saveState();
    });

    playBtn.addEventListener("click", togglePlay);

    // collapsed: only the header row (play/pause + this toggle) stays visible
    function setCollapsed(v: boolean) {
      collapsed = v;
      debugPanel.classList.toggle("collapsed", collapsed);
      collapseBtn.innerHTML = collapsed ? "&#9652;" : "&#9662;";
      collapseBtn.title = collapsed ? "Expand" : "Collapse";
    }

    collapseBtn.addEventListener("click", () => {
      setCollapsed(!collapsed);
      saveState();
    });

    (document.getElementById("resetBtn") as HTMLButtonElement).addEventListener(
      "click",
      () => {
        playing = false;
        playBtn.innerHTML = "&#9654;";
        keyframes = [{ points: defaultPoints() }];
        selected = 0;
        activeIndex = -1;
        rebuildStrip();
        renderSelectedStatic();
        saveState();
      },
    );

    // reflects softness/radius/speed/snap loaded from storage in the actual
    // control widgets — the JS state was restored above, but the DOM still
    // shows whatever values are hardcoded in the markup until this runs
    function syncControlsToState() {
      softnessSlider.value = String(Math.round(softness * 100));
      softnessVal.textContent = softnessSlider.value;
      radiusSlider.value = String(Math.round(radius * 100));
      radiusVal.textContent = radiusSlider.value;
      speedSlider.value = String(segDuration);
      speedVal.textContent = (segDuration / 1000).toFixed(2);
      snapBtn.textContent =
        snapStep === 0.5
          ? "Snap 1/2"
          : snapStep === 0.25
            ? "Snap 1/4"
            : "Snap Off";
      snapBtn.classList.toggle("active", snapStep !== 0);
    }

    // ---------- init ----------
    stagePx = uiStage.getBoundingClientRect().width || 350;
    syncControlsToState();
    setCollapsed(collapsed);
    buildStageOnce();
    rebuildStrip();
    renderSelectedStatic();
  })();
</script>

<style is:global>
  :root {
    --bg: #d6d6d3;
    --panel: #e6e6e2;
    --line: #b7b6b1;
    --line-strong: #1a1a1a;
    --ink: #171717;
    --ink-dim: #6f6e6a;
    --accent: #e8560f;
    --blob: #181818;
    --danger: #b3382a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #202020;
      --panel: #292927;
      --line: #48473f;
      --line-strong: #4e4d47;
      --ink: #eeecea;
      --ink-dim: #8d8c89;
      --accent: #ff7a33;
      --blob: #eeeeee;
      --danger: #d9604c;
    }
  }
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    color: var(--ink);
    font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
    overflow: hidden;
    overscroll-behavior: none;
    touch-action: none;
  }

  /* ===== rendering (matches the reference recipe — see comment in markup) ===== */

  /* base — the "white background" the reference uses; ours is themed */
  .field {
    position: relative;
    width: 100vw;
    height: 100dvh;
    background: var(--bg);
    touch-action: none;
  }

  /* centered square that both the raw pixels and the UI (grid/handles) are
     positioned against — kept as two separate same-sized/same-position
     elements (not one shared box) because the pixels must sit *below* the
     effect overlays while the UI must sit *above* them */
  .stage {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(92vw, 92dvh, 480px);
